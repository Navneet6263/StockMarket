# ══════════════════════════════════════════════════════════════════════════════
# STOCK INTELLIGENCE — Environment Configuration
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════════════════════

# ── Broker API (AngelOne SmartAPI) ───────────────────────────────────────────
# Get from: https://smartapi.angelbroking.com → My Apps
BROKER_PROVIDER=angelone
ANGELONE_API_KEY=your_api_key_here
ANGELONE_CLIENT_ID=your_client_id_here
ANGELONE_PASSWORD=your_mpin_here
ANGELONE_TOTP_KEY=your_totp_base32_secret_here
ANGELONE_CA_BUNDLE=certifi
# Last resort for local Windows/corporate-proxy certificate errors. Less secure when true.
ANGELONE_DISABLE_SSL_VERIFY=false

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/stockdb

# ── Telegram Alerts ───────────────────────────────────────────────────────────
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_MARKET_ALERTS_ENABLED=true

# ── Core Scanner ──────────────────────────────────────────────────────────────
BENCHMARK_SYMBOL=NIFTY
UNIVERSE_SIZE=1500
SCAN_SYMBOL_LIMIT=1500
MIN_PRICE=10
MIN_VOLUME=100000

# ── Tracker DB ────────────────────────────────────────────────────────────────
TRACK_DB_PATH=services/api/data/market_intelligence.db

# ── Feature Flags (true/false) ────────────────────────────────────────────────
ENABLE_BREADTH_GATE=true
ENABLE_BASE_QUALITY=true
ENABLE_DELIVERY_CHECK=true
ENABLE_SWING_5D=true
ENABLE_SECTOR_RS=true
ENABLE_FII_DII=true
ENABLE_PCR=true
ENABLE_DYNAMIC_TRAILING_STOP=true

# ── AngelOne Live Services ────────────────────────────────────────────────────
ENABLE_LIVE_FEED=true
ENABLE_DELIVERY_FETCH=true
ENABLE_AUTO_ORDER=false
AUTO_ORDER_MAX_PER_DAY=3
AUTO_ORDER_MAX_CAPITAL_PCT=5.0

# ── Fast Pattern Discovery ────────────────────────────────────────────────────
SCAN_INTERVAL_SEC=30
SCAN_CACHE_TTL_SEC=30
QUOTE_CACHE_TTL_SEC=2
INTRADAY_CACHE_TTL_SEC=20
SCAN_INTRADAY_LIMIT=48

# ── AI Intelligence (Finnhub + Gemini) ────────────────────────────────────────
# Finnhub: https://finnhub.io → Free API key
ENABLE_FINNHUB=true
FINNHUB_API_KEY=your_finnhub_api_key_here

# Gemini: https://aistudio.google.com → Get API Key (FREE)
ENABLE_GEMINI_AI=true
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_TEMPERATURE=0.15
GEMINI_THINKING_BUDGET=0
AI_ENRICH_LIMIT=6
