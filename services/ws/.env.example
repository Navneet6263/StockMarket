WS_PORT=4001
API_URL=http://localhost:8000

# Set either BROKER_PROVIDER=angelone or ENABLE_ANGELONE_WS=true to enable direct tick streaming.
BROKER_PROVIDER=angelone
ENABLE_ANGELONE_WS=true
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PASSWORD=
ANGELONE_TOTP_KEY=

# 1=LTP, 2=QUOTE, 3=SNAP_QUOTE. LTP is fastest and lightest.
ANGELONE_WS_MODE=1
ANGELONE_WS_MAX_TOKENS=200
ANGELONE_WS_STALE_MS=1500
FALLBACK_POLL_INTERVAL_MS=500
FALLBACK_POLL_CONCURRENCY=10

# Keep SSL verification on. Set true only as a local last resort for cert-store/proxy issues.
ANGELONE_CA_BUNDLE=certifi
ANGELONE_DISABLE_SSL_VERIFY=false
